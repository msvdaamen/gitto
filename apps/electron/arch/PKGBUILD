# Packages the app that `electron-forge package` built for Linux into an Arch package, so run that
# first: `pnpm make:arch` does both. CI does the same (see .github/workflows/release.yml).

_version=$(sed -nE 's/^  "version": "(.+)",$/\1/p' "$startdir/../package.json")

pkgname=gitto
# pacman's versions have no `-`; without them, 1.2.4nightly… and 1.3.0beta.1 still sort before 1.2.4
# and 1.3.0, as their semver versions do.
pkgver=${_version//-/}
pkgrel=1
pkgdesc='Gitto desktop app'
arch=('x86_64')
url='https://github.com/msvdaamen/gitto'
license=('custom')
depends=('git>=2.41' 'gtk3' 'nss' 'alsa-lib')
# Electron's binaries come prebuilt; stripping them can break them.
options=('!strip' '!debug')

package() {
  install -d "$pkgdir/usr/lib/$pkgname" "$pkgdir/usr/bin"
  cp -a "$startdir/../out/Gitto-linux-x64/." "$pkgdir/usr/lib/$pkgname/"
  # Chromium's sandbox helper only works setuid root.
  chmod 4755 "$pkgdir/usr/lib/$pkgname/chrome-sandbox"
  ln -s "/usr/lib/$pkgname/gitto" "$pkgdir/usr/bin/gitto"

  install -Dm644 "$startdir/gitto.desktop" "$pkgdir/usr/share/applications/gitto.desktop"
  install -Dm644 "$startdir/../../ui/src/assets/logo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/gitto.svg"
  install -Dm644 "$startdir/../assets/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/gitto.png"
}
